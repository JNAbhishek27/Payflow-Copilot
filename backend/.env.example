# ==========================================
# PayFlow Copilot - Backend Environment Variables
# ==========================================

# 1. Google Gemini API (Get key: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# 2. PayPal Sandbox Credentials (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_webhook_id
PAYPAL_MODE=sandbox

# 3. Database Connection URL
# Supabase PostgreSQL: postgresql://postgres.xxxx:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Local development fallback: sqlite:///./payflow.db
DATABASE_URL=your_supabase_database_url

# 4. Host & Security
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development

